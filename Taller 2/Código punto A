def suma_seno(x, tol=1e-8, max_iter=200):

    term = x
    total = x
    n = 0

    for i in range(max_iter):

        n += 1

        term = -term * x**2 / ((2*n)*(2*n + 1))

        total = total + term

        if abs(term) < tol * max(1, abs(total)):
            break

    return total, i + 1

